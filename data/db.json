  "courses": [
    {
      "id": "course-compliance-essentials",
      "title": "Kasi Shop Compliance Essentials",
      "summary": "A short, plain-language course covering what every township shop owner needs to trade legally — registration, food safety, and by-laws.",
      "issuedWith": "Dept. of Small Business Development pilot programme",
      "passMark": 0.7,
      "lessons": [
        {
          "id": "l1",
          "title": "Getting registered",
          "minutes": 4,
          "body": [
            "Every trading business needs to be registered with the Companies and Intellectual Property Commission (CIPC), and with SARS for tax purposes. If you employ anyone, you also need to register for UIF.",
            "Registration is what makes a pool, an exchange trade, or a customer order enforceable — it's what turns a stall into a business the law (and this platform) recognises.",
            "Municipalities also require spaza shops and food handling outlets to register locally, following the national registration drive that began in late 2024."
          ]
        },
        {
          "id": "l2",
          "title": "Food safety and the Certificate of Acceptability",
          "minutes": 5,
          "body": [
            "If you sell any food — packaged or prepared — your premises need a Certificate of Acceptability (CoA) from your municipality's Environmental Health Department, under Regulation R638.",
            "This covers safe storage temperatures, pest control, clean surfaces, and separating raw and cooked food.",
            "Operating without a CoA is a criminal offence, and non-compliant premises can be closed immediately by inspectors — this isn't optional paperwork."
          ]
        },
        {
          "id": "l3",
          "title": "Municipal by-laws and trading permits",
          "minutes": 3,
          "body": [
            "Beyond national registration, your local municipality may require a trading licence or permit for the specific location you trade from.",
            "Keep proof of address and, where relevant, your landlord or property owner's consent — inspectors and verifiers will ask for these alongside your CIPC and CoA documents."
          ]
        },
        {
          "id": "l4",
          "title": "Why this matters for you on Mzansi Business",
          "minutes": 2,
          "body": [
            "Only verified shops appear on the customer map, can post or respond to exchange listings, and can join bulk-buying pools.",
            "This protects customers, and it protects you — a verified badge is what lets other shop owners trust you enough to trade stock with you.",
            "Passing this course issues you a certificate and moves your shop straight to Verified. You can also upload your own documents instead, which a human verifier will check."
          ]
        }
      ],
      "quiz": [
        {
          "id": "q1",
          "question": "Which three bodies must most trading businesses register with?",
          "options": [
            "CIPC, SARS, and UIF (if you employ staff)",
            "Only your local municipality",
            "Only the bank you use",
            "Facebook Business and Google Maps"
          ],
          "correctIndex": 0
        },
        {
          "id": "q2",
          "question": "What does a Certificate of Acceptability cover?",
          "options": [
            "Your business's tax rate",
            "Food safety and hygiene at your premises, under Regulation R638",
            "Your eligibility for a bank loan",
            "Your shop's insurance policy"
          ],
          "correctIndex": 1
        },
        {
          "id": "q3",
          "question": "What can happen if your premises don't meet food safety regulations?",
          "options": [
            "Nothing, as long as you're registered with CIPC",
            "You get a warning letter after a year",
            "Inspectors can close the premises immediately",
            "You lose your CIPC registration only"
          ],
          "correctIndex": 2
        },
        {
          "id": "q4",
          "question": "Why does Mzansi Business require shops to be verified?",
          "options": [
            "To charge higher fees to verified shops",
            "So only compliant shops appear to customers and can trade with other shops",
            "Verification is just cosmetic and has no effect on features",
            "To limit the number of shops on the platform"
          ],
          "correctIndex": 1
        },
        {
          "id": "q5",
          "question": "If you don't have your documents ready yet, what can you do on this platform?",
          "options": [
            "Nothing — you cannot register a shop at all",
            "Trade immediately while you wait",
            "Complete this compliance course to become verified instead",
            "Ask a customer to vouch for you"
          ],
          "correctIndex": 2
        }
      ]
    }
  ],
